<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Chispa.Sign</AssemblyName>
    <!-- Packaging and signing run in the RELEASE environment, next to the private key. This tool is
         deliberately not referenced by the server or the loader: neither of them can sign. -->
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../shared/ReleaseSignature.cs" Link="ReleaseSignature.cs" />
  </ItemGroup>
</Project>
