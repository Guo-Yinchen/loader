<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- One definition of the signed statement, shared with the loader and the signing tool: a
         copy per project would be three chances to disagree about what a signature covers. -->
    <Compile Include="../shared/ReleaseSignature.cs" Link="ReleaseSignature.cs" />
    <EmbeddedResource Include="Ui/style.css" LogicalName="Chispa.Admin.style.css" />
    <EmbeddedResource Include="Ui/app.js" LogicalName="Chispa.Admin.app.js" />
    <EmbeddedResource Include="../assets/branding/chispa.svg" LogicalName="Chispa.Admin.chispa.svg" />
  </ItemGroup>
</Project>
